<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FFF6F3FF"
    android:orientation="vertical"
    android:padding="8dp">
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">
        <TextView
            android:id="@+id/widget_notes_header"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:padding="8dp"
            android:ellipsize="end"
            android:maxLines="1"
            android:text="@string/widget_recent_header"
            android:textColor="#FF332A45"
            android:textSize="16sp"
            android:textStyle="bold" />
        <TextView
            android:id="@+id/widget_notes_new"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:contentDescription="@string/widget_new_note"
            android:gravity="center"
            android:text="+"
            android:textColor="#FF332A45"
            android:textSize="26sp" />
    </LinearLayout>
    <ListView
        android:id="@+id/widget_notes_list"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:divider="@android:color/transparent"
        android:scrollbars="vertical" />
</LinearLayout>
