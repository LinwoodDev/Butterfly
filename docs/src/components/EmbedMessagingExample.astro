  .embed-demo__panel {
    border: 1px solid var(--sl-color-gray-5);
    border-radius: 0.45rem;
    background: var(--sl-color-bg-nav);
    min-inline-size: 0;
    padding: 0.75rem;
  }

  .embed-demo__panel-heading {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    margin-block-end: 0.75rem;
  }

  .embed-demo__title {
    color: var(--sl-color-white);
    font-weight: 700;
  }

  .embed-demo__panel-heading span {
    border: 1px solid var(--sl-color-gray-5);
    border-radius: 999px;
    color: var(--sl-color-gray-2);
    font-size: var(--sl-text-xs);
    font-weight: 700;
    padding: 0.15rem 0.55rem;
  }

  .embed-demo__messages {
    display: grid;
    gap: 0.5rem;
    list-style: none;
    margin: 0;
    max-block-size: 18rem;
    overflow: auto;
    padding: 0;
  }

  .embed-demo__message,
  .embed-demo__empty {
    border: 1px solid var(--sl-color-gray-6);
    border-radius: 0.55rem;
    padding: 0.65rem;
  }

  .embed-demo__message--received {
    border-color: color-mix(in srgb, var(--sl-color-accent) 45%, var(--sl-color-gray-6));
  }

  .embed-demo__message-meta {
    display: flex;
    align-items: center;
    gap: 0.45rem;
    color: var(--sl-color-gray-3);
    font-size: var(--sl-text-xs);
  }

  .embed-demo__message-meta strong {
    color: var(--sl-color-white);
  }

  .embed-demo__message-meta time {
    margin-inline-start: auto;
  }

  .embed-demo__message p,
  .embed-demo__empty {
