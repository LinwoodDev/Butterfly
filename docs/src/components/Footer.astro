---
import StarlightFooter from "@astrojs/starlight/components/Footer.astro";
import { Image } from "astro:assets";
---

<StarlightFooter {...Astro.props}>
  <slot />
</StarlightFooter>
<footer class="real-footer">
  <a class="brand" href="https://linwood.dev" target="_blank">
    <Image
      src="https://www.linwood.dev/logos/logo.png"
      width="32"
      height="32"
      alt=""
    />
    <strong>Linwood</strong>
  </a>
  <div class="links">
    <a target="_blank" class="btn" href="https://linwood.dev/imprint">Imprint</a>
    <a target="_blank" class="btn" href="https://linwood.dev/privacypolicy">
      Privacy policy
    </a>
  </div>
</footer>

<style lang="scss">
  .real-footer {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: center;
    gap: 0.75rem 1.25rem;
    width: fit-content;
    margin-top: 5rem;
    margin-left: auto;
    margin-right: auto;
    padding: 1rem;
    background-color: var(--sl-color-gray-6);
    border-radius: 1rem;
  }

  .brand {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    color: var(--sl-color-white);
    text-decoration: none;
  }

  .brand:hover {
    text-decoration: none;
  }

  .links {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 0.5rem;
  }

  .btn {
    color: var(--sl-color-white);
    font-weight: 500;
    text-decoration: none;
  }

  .btn:hover {
    text-decoration: none;
  }
</style>
